      "source": "tests/unit/db/test_dml_analysis.py::test_analyze_dml_collects_merge_events_and_table (adapted)",
      "sql": "MERGE INTO t USING s ON t.id = s.id WHEN MATCHED THEN UPDATE SET val = s.val WHEN NOT MATCHED THEN INSERT (id, val) VALUES (s.id, s.val);",
      "facts": {
        "operation": "MERGE",
        "kind": "DML",
        "objects": [
          {"name": "t", "type": "TABLE", "role": "altered", "schema": null},
          {"name": "s", "type": "TABLE", "role": "referenced", "schema": null}
        ],
        "target": "t",
        "predicate": null,
        "affected_columns": ["val"],
        "events": ["INSERT", "UPDATE"],
        "diagnostic": null,
        "error": null
      }
    },
